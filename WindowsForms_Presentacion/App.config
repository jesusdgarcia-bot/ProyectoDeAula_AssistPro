        <add key="CamaraFacial" value="0" />
        <add key="PythonMediaPipe" value="..\..\..\.venv-mediapipe\Scripts\python.exe" />
        <add key="HabilitarBiometriaFacial" value="false" />
        <add key="IdTerminalAsistencia" value="" />
