<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Oracle Autonomous Database (OCI Always Free), servicio assistpro_low, TLS sin wallet.
             El usuario debe ser el dueño del esquema ASISTENCIA.
             Repositorio privado: la clave va en el repo para que todo el equipo conecte sin configurar nada. -->
        <add name="AssistProContext"
             providerName="Oracle.ManagedDataAccess.Client"
             connectionString="User Id=ASISTENCIA;Password=AssistPro#2026x;Data Source=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.sa-bogota-1.oraclecloud.com))(connect_data=(service_name=g084cdebb3a571a_assistpro_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)));" />
        <!-- Conexión local anterior (Oracle XE 18c):
             User Id=ASISTENCIA;Password=asistencia;Data Source=localhost:1521/XEPDB1; -->
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
