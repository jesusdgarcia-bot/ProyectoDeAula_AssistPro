<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Oracle XE 18c: el usuario debe ser el dueño del esquema ASISTENCIA (ver README). -->
        <add name="AssistProContext"
             providerName="Oracle.ManagedDataAccess.Client"
             connectionString="User Id=ASISTENCIA;Password=CAMBIAR_PASSWORD;Data Source=localhost:1521/XEPDB1;" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
